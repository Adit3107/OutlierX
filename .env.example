# Database Connection (Neon PostgreSQL)
DATABASE_URL="postgresql://user:password@ep-sample-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require"

# Network Configurations
BACKEND_PORT=5000
FRONTEND_PORT=3000
ML_SERVICE_URL="http://localhost:8000"
NEXT_PUBLIC_API_URL="http://localhost:5000/api/v1"

# Clerk Authentication Secrets
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_sample
CLERK_SECRET_KEY=sk_test_sample
CLERK_WEBHOOK_SECRET="whsec_sample"
JWT_SECRET="replace_with_random_string"

# Storage & Email Integrations
STORAGE_PROVIDER="dummy"
STORAGE_BUCKET="dummy"
EMAIL_PROVIDER="dummy"
EMAIL_API_KEY="dummy"

# Model Registry & Evaluation Configuration
MODEL_REGISTRY_ENABLED=true
MODEL_REGISTRY_PATH=./registry
ACTIVE_MODEL=isolation_forest
ACTIVE_MODEL_VERSION=v1.2.0
ENABLE_MODEL_COMPARISON=true
ENABLE_MODEL_ROLLBACK=true
ENABLE_MODEL_ARCHIVING=true
ENABLE_EVALUATION_HISTORY=true
ENABLE_DEPLOYMENT_HISTORY=true
MODEL_METADATA_CACHE=true
MODEL_CACHE_TTL=3600
MAX_MODEL_VERSIONS=100
ENABLE_MODEL_METRICS=true
EVALUATION_RETENTION_DAYS=365
METRICS_REFRESH_INTERVAL=3600
ENABLE_CONFUSION_MATRIX=true
ENABLE_PERFORMANCE_COMPARISON=true
MODEL_LOG_LEVEL=info

# ML Monitoring, Drift Detection & Analytics
ML_MONITORING_ENABLED=true
ML_MONITORING_INTERVAL_MINUTES=60
DRIFT_DETECTION_ENABLED=true
PSI_LOW_THRESHOLD=0.10
PSI_MEDIUM_THRESHOLD=0.20
PSI_HIGH_THRESHOLD=0.30
KS_P_VALUE_THRESHOLD=0.05
PREDICTION_DRIFT_THRESHOLD=0.20
CONFIDENCE_DROP_THRESHOLD=0.15
MODEL_ERROR_RATE_THRESHOLD=0.05
MODEL_P95_LATENCY_MS=5000
DATA_QUALITY_THRESHOLD=0.95
ML_HEALTH_WARNING_THRESHOLD=70
ML_HEALTH_DEGRADED_THRESHOLD=50
ML_HEALTH_CRITICAL_THRESHOLD=30
MONITORING_RETENTION_DAYS=365
MONITORING_BATCH_SIZE=1000
MONITORING_LOG_LEVEL=info
