# =============================================
# Anomalyze Production Environment Variables
# =============================================

NODE_ENV=production
LOG_LEVEL=info

# ---- Database (Supabase PostgreSQL) ----
DATABASE_URL=postgresql://user:password@host:port/database

# ---- Auth / JWT ----
JWT_SECRET=your-jwt-secret-key

# ---- Clerk ----
CLERK_PUBLISHABLE_KEY=pk_test_YOUR_CLERK_PUBLISHABLE_KEY
CLERK_SECRET_KEY=sk_test_YOUR_CLERK_SECRET_KEY
CLERK_WEBHOOK_SECRET=whsec_YOUR_CLERK_WEBHOOK_SECRET

# ---- Google OAuth ----
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET

# ---- Razorpay ----
RAZORPAY_KEY_ID=rzp_test_YOUR_RAZORPAY_KEY_ID
RAZORPAY_KEY_SECRET=YOUR_RAZORPAY_KEY_SECRET
RAZORPAY_WEBHOOK_SECRET=YOUR_RAZORPAY_WEBHOOK_SECRET

# ---- Email (Gmail SMTP) ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=YOUR_SMTP_PASSWORD
EMAIL_FROM=support@anomalyze.com

# ---- Twilio (SMS & Voice) ----
TWILIO_ACCOUNT_SID=YOUR_TWILIO_ACCOUNT_SID
TWILIO_AUTH_TOKEN=YOUR_TWILIO_AUTH_TOKEN
TWILIO_PHONE_NUMBER=YOUR_TWILIO_PHONE_NUMBER
TWILIO_CALL_FROM=YOUR_TWILIO_PHONE_NUMBER

# ---- Kafka Topics ----
KAFKA_TRANSACTIONS_TOPIC=transactions
KAFKA_ANOMALIES_TOPIC=anomalies
KAFKA_ALERTS_TOPIC=alerts

# ---- Analytics ----
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# ---- Ingestion ----
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=50
ALLOWED_MIME_TYPES=text/csv,application/json
BATCH_CONCURRENCY=5

# ---- ML Model ----
MODEL_PATH=./models/current_model.pkl
MODEL_VERSION=v1.0.0
ANOMALY_THRESHOLD=0.65
VELOCITY_WINDOW_SECONDS=600
STORAGE_TYPE=local
LOCAL_STORAGE_PATH=./data
DEBUG=false

# ---- URLs ----
FRONTEND_URL=https://anomalyze.me
API_URL=https://backend.anomalyze.me
