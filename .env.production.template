# ==========================================
# Anomalyze Production Environment Variables
# ==========================================

# 1. Database (Supabase PostgreSQL)
DATABASE_URL="postgres://postgres.xxx:password@aws-0-xx.pooler.supabase.com:6543/postgres?pgbouncer=true"

# 2. Redis (Aiven / Upstash / AWS ElastiCache)
REDIS_HOST="your-redis-host"
REDIS_PORT="6379"
REDIS_PASSWORD="your-redis-password"

# 3. Kafka / Redpanda (Upstash / Confluent)
KAFKA_BOOTSTRAP_SERVERS="your-kafka-broker:9092"
KAFKA_USERNAME="your-kafka-username"
KAFKA_PASSWORD="your-kafka-password"
KAFKA_MECHANISM="scram-sha-256"

# 4. Authentication (Clerk / JWT)
JWT_SECRET="your-super-secure-production-jwt-secret"
CLERK_SECRET_KEY="sk_live_..."

# 5. Payments (Razorpay)
RAZORPAY_KEY_ID="rzp_live_..."
RAZORPAY_KEY_SECRET="your-razorpay-secret"
RAZORPAY_WEBHOOK_SECRET="your-webhook-secret"

# 6. Notifications (Resend / SendGrid / Twilio)
SMTP_HOST="smtp.sendgrid.net"
SMTP_PORT="587"
SMTP_USER="apikey"
SMTP_PASS="SG...."
EMAIL_FROM="alerts@anomalyze.com"

TWILIO_ACCOUNT_SID="AC..."
TWILIO_AUTH_TOKEN="..."
TWILIO_PHONE_NUMBER="+1234567890"

# 7. Frontend URLs
FRONTEND_URL="https://anomalyze.com"
API_URL="https://anomalyze.com/api"
