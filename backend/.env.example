# Database Configuration (Neon PostgreSQL)
DATABASE_URL="postgresql://username:password@ep-example.us-east-1.aws.neon.tech/anomalyze?sslmode=require"

# Application configurations
PORT=5000
NODE_ENV="development"
FRONTEND_URL="http://localhost:3000"

# ML Python Service & Feature Engineering
ML_SERVICE_URL="http://localhost:8000"
PIPELINE_VERSION="v1.0.0"
FEATURE_VERSION="features-v2.1"
FEATURE_SCALER="standard"
FEATURE_ENCODER="frequency"
FEATURE_STORE_ENABLED=true
FEATURE_VECTOR_BATCH_SIZE=1000
# Decision Engine Configuration
RULE_ENGINE_WEIGHT=0.60
ML_ENGINE_WEIGHT=0.40
ISOLATION_FOREST_WEIGHT=0.40
LOF_WEIGHT=0.30
ONE_CLASS_SVM_WEIGHT=0.30
LOW_RISK_THRESHOLD=20
MEDIUM_RISK_THRESHOLD=45
HIGH_RISK_THRESHOLD=70
CRITICAL_RISK_THRESHOLD=90
CONFIDENCE_MINIMUM=60
ENABLE_HISTORICAL_SCORING=true
ENABLE_RULE_SCORING=true
ENABLE_MODEL_AGREEMENT=true

# Clerk Authentication Secrets
CLERK_SECRET_KEY="sk_test_xxxxxxxxxxxxxxxxx"
CLERK_PUBLISHABLE_KEY="pk_test_xxxxxxxxxxxxx"
JWT_SECRET="replace_with_random_string"

# Cloud Storage Configuration Placeholders
STORAGE_PROVIDER="dummy"
STORAGE_BUCKET="dummy"

# Third-party Services Configuration Placeholders
EMAIL_PROVIDER="dummy"
EMAIL_API_KEY="dummy"
