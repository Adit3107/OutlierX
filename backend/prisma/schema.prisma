datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum Role {
  OWNER
  ADMIN
  ANALYST
  MEMBER
  VIEWER
}

enum MembershipStatus {
  ACTIVE
  INACTIVE
  INVITED
  SUSPENDED
}

enum SubscriptionPlan {
  FREE
  PRO
  ENTERPRISE
}

enum SubscriptionStatus {
  ACTIVE
  TRIAL
  PAST_DUE
  CANCELLED
}

enum ApiKeyStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

enum UploadStatus {
  UPLOADING
  UPLOADED
  PARSING
  PROCESSING
  COMPLETED
  FAILED
}

enum ProcessingStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum AlertSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AlertStatus {
  OPEN
  RESOLVED
  ARCHIVED
}

enum RuleCategory {
  AMOUNT
  LOCATION
  MERCHANT
  TIME
  ACCOUNT
  DEVICE
  CUSTOM
}

enum ConditionOperator {
  EQ
  NEQ
  GT
  GTE
  LT
  LTE
  CONTAINS
  NOT_CONTAINS
  IN
  NOT_IN
  EXISTS
  MISSING
  BETWEEN
}

enum LogicalOperator {
  AND
  OR
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum DecisionRecommendation {
  APPROVE
  MONITOR
  MANUAL_REVIEW
  BLOCK_TRANSACTION
  ESCALATE
}

enum RuleExecutionSource {
  UPLOAD
  MANUAL
  PLAYGROUND
}

enum ActivityEntity {
  USER
  ORGANIZATION
  MEMBERSHIP
  API_KEY
  UPLOAD
  TRANSACTION
  RULE
  ALERT
  MODEL
  SYSTEM
}

enum ModelStatus {
  ACTIVE
  INACTIVE
  EXPERIMENTAL
  CANARY
  ARCHIVED
}

model User {
  id                      String        @id @default(uuid())
  clerkUserId             String        @unique
  email                   String        @unique
  firstName               String?
  lastName                String?
  avatar                  String?
  status                  UserStatus    @default(ACTIVE)
  currentOrganizationId   String?
  theme                   String?       @default("dark")
  language                String?       @default("en")
  timezone                String?       @default("UTC")
  notificationPreferences Json?
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt

  currentOrganization Organization? @relation("CurrentOrganization", fields: [currentOrganizationId], references: [id], onDelete: SetNull)
  memberships         Membership[]
  uploads             Upload[]
  apiKeys             ApiKey[]
  alerts              Alert[]       @relation("AlertUser")
  assignedAlerts      Alert[]       @relation("AlertAssignedAnalyst")
  activityLogs        ActivityLog[]
  createdRules        Rule[]
  decisions           Decision[]
  alertComments       AlertComment[]

  @@index([email])
  @@index([clerkUserId])
  @@index([currentOrganizationId])
  @@index([status])
  @@index([createdAt])
}

model Organization {
  id                 String             @id @default(uuid())
  name               String
  slug               String             @unique
  logo               String?
  industry           String?
  website            String?
  subscriptionPlan   SubscriptionPlan   @default(FREE)
  subscriptionStatus SubscriptionStatus @default(TRIAL)
  maxUsers           Int                @default(5)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  currentUsers   User[]          @relation("CurrentOrganization")
  memberships    Membership[]
  uploads        Upload[]
  transactions   Transaction[]
  apiKeys        ApiKey[]
  alerts         Alert[]
  rules          Rule[]
  ruleExecutions RuleExecution[]
  mlPredictions  MlPrediction[]
  activityLogs   ActivityLog[]
  decisions      Decision[]
  featureVectors FeatureVector[]
  monitoringSnapshots   MLMonitoringSnapshot[]
  featureDriftMetrics   FeatureDriftMetric[]
  predictionDriftMetrics PredictionDriftMetric[]
  dataQualityMetrics    DataQualityMetric[]
  modelHealthLogs       ModelHealthLog[]

  @@index([subscriptionPlan])
  @@index([subscriptionStatus])
  @@index([createdAt])
}

model Membership {
  id             String           @id @default(uuid())
  organizationId String
  userId         String
  role           Role             @default(MEMBER)
  status         MembershipStatus @default(ACTIVE)
  joinedAt       DateTime         @default(now())
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
  @@index([role])
  @@index([status])
  @@index([createdAt])
  @@index([organizationId, role])
}

model ApiKey {
  id             String       @id @default(uuid())
  organizationId String
  createdById    String?
  name           String
  keyHash        String       @unique
  lastUsedAt     DateTime?
  expiresAt      DateTime?
  status         ApiKeyStatus @default(ACTIVE)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User?        @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([createdById])
  @@index([status])
  @@index([createdAt])
  @@index([organizationId, status])
}

model Upload {
  id               String       @id @default(uuid())
  organizationId   String
  uploadedById     String       @map("uploadedBy")
  filename         String
  originalFilename String
  storageKey       String
  storageUrl       String
  mimeType         String
  fileSize         Int
  fileHash         String
  status           UploadStatus @default(UPLOADING)
  totalRows        Int          @default(0)
  processedRows    Int          @default(0)
  failedRows       Int          @default(0)
  processingTime   Int?
  errorSummary     Json?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  uploadedBy   User         @relation(fields: [uploadedById], references: [id], onDelete: Restrict)
  transactions Transaction[]

  @@unique([organizationId, fileHash])
  @@index([organizationId])
  @@index([uploadedById])
  @@index([status])
  @@index([createdAt])
  @@index([organizationId, status])
}

model Transaction {
  id               String   @id @default(uuid())
  organizationId   String
  uploadId         String
  transactionId    String
  timestamp        DateTime
  amount           Decimal  @db.Decimal(18, 2)
  currency         String
  merchant         String
  merchantCategory String?
  accountNumber    String?
  country          String?
  city             String?
  paymentMethod    String?
  description      String?
  referenceNumber  String?
  customerId       String?
  status           String   @default("IMPORTED")
  metadata         Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  upload       Upload       @relation(fields: [uploadId], references: [id], onDelete: Cascade)
  ruleExecutions RuleExecution[]
  mlPrediction   MlPrediction?
  featureVector  FeatureVector?

  @@index([organizationId])
  @@index([transactionId])
  @@index([timestamp])
  @@index([merchant])
  @@index([country])
  @@index([amount])
  @@index([uploadId])
  @@index([organizationId, timestamp])
  @@index([organizationId, createdAt])
  @@index([organizationId, merchant])
  @@index([organizationId, country])
  @@index([organizationId, currency])
  @@index([organizationId, status])
}

model FeatureVector {
  id               String   @id @default(uuid())
  organizationId   String
  transactionId    String   @unique
  pipelineVersion  String   @default("v1.0.0")
  featureVersion   String   @default("features-v2.1")
  featureCount     Int
  vector           Json
  status           String   @default("GENERATED")
  processingTimeMs Int
  metadata         Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  transaction  Transaction  @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([transactionId])
  @@index([pipelineVersion])
  @@index([featureVersion])
  @@index([status])
  @@index([createdAt])
  @@index([organizationId, createdAt])
}

model MlPrediction {
  id              String   @id @default(uuid())
  organizationId  String
  transactionId   String   @unique
  modelName       String   @default("isolation_forest")
  algorithm       String   @default("IsolationForest")
  rawScore        Float?
  mlScore         Float
  mlPrediction    String
  confidence      Float
  modelVersion    String
  warnings        Json?
  processedAt     DateTime
  processingTime  Int
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  transaction  Transaction  @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  decision     Decision?

  @@index([organizationId])
  @@index([transactionId])
  @@index([modelName])
  @@index([mlPrediction])
  @@index([modelVersion])
  @@index([processedAt])
  @@index([organizationId, processedAt])
}

model ModelRegistry {
  id                String    @id @default(uuid())
  modelName         String    @unique
  algorithm         String
  version           String
  status            String    @default("ACTIVE")
  supportedFeatures Json?
  hyperparameters   Json?
  accuracy          Float?
  totalInferences   Int       @default(0)
  avgLatencyMs      Float     @default(0.0)
  lastUsedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([modelName])
  @@index([algorithm])
  @@index([status])
}

model MLModel {
  id            String          @id @default(uuid())
  name          String          @unique
  algorithm     String
  description   String?
  status        ModelStatus     @default(ACTIVE)
  activeVersion String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  versions          MLModelVersion[]
  deploymentHistory ModelDeploymentHistory[]

  @@index([name])
  @@index([algorithm])
  @@index([status])
}

model MLModelVersion {
  id                   String      @id @default(uuid())
  modelId              String
  version              String
  status               ModelStatus @default(INACTIVE)
  description          String?
  checksum             String
  supportedFeatures    Json
  expectedFeatureCount Int
  hyperparameters      Json?
  trainingConfig       Json?
  artifactPath         String
  pipelineVersion      String      @default("v1.0.0")
  featureVersion       String      @default("features-v2.1")
  scikitVersion        String?     @default("1.5.0")
  pythonVersion        String?     @default("3.11")
  frameworkVersion     String?     @default("FastAPI 0.111")
  author               String?     @default("OutlierX ML Team")
  trainingDataset      String?     @default("sample_transactions.csv")
  activeFlag           Boolean     @default(false)
  productionFlag       Boolean     @default(false)
  experimentalFlag     Boolean     @default(false)
  archivedFlag         Boolean     @default(false)
  createdDate          DateTime    @default(now())
  deploymentDate       DateTime?
  previousVersion      String?
  nextVersion          String?
  reasonForUpdate      String?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  model             MLModel                  @relation(fields: [modelId], references: [id], onDelete: Cascade)
  evaluations       ModelEvaluation[]
  deploymentHistory ModelDeploymentHistory[]

  @@unique([modelId, version])
  @@index([modelId])
  @@index([version])
  @@index([status])
  @@index([activeFlag])
  @@index([productionFlag])
}

model ModelEvaluation {
  id                     String    @id @default(uuid())
  versionId              String
  datasetUsed            String
  accuracy               Float?
  precision              Float
  recall                 Float
  f1Score                Float
  rocAuc                 Float
  prAuc                  Float
  confusionMatrix        Json
  falsePositiveRate      Float
  falseNegativeRate      Float
  avgConfidence          Float
  predictionDistribution Json?
  inferenceTimeMs        Float
  latencyMs              Float
  memoryMb               Float
  evaluationDate         DateTime  @default(now())
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  version MLModelVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@index([versionId])
  @@index([evaluationDate])
}

model ModelComparison {
  id                String   @id @default(uuid())
  versionAId        String
  versionBId        String
  metricsComparison Json
  winnerVersionId   String?
  notes             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([versionAId])
  @@index([versionBId])
  @@index([createdAt])
}

model ModelDeploymentHistory {
  id            String   @id @default(uuid())
  modelId       String
  versionId     String
  action        String
  performedBy   String?  @default("system")
  reason        String?
  previousState Json?
  newState      Json?
  timestamp     DateTime @default(now())
  createdAt     DateTime @default(now())

  model   MLModel        @relation(fields: [modelId], references: [id], onDelete: Cascade)
  version MLModelVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@index([modelId])
  @@index([versionId])
  @@index([action])
  @@index([timestamp])
}

model Rule {
  id             String        @id @default(uuid())
  organizationId String
  name           String
  description    String?
  category       RuleCategory
  severity       AlertSeverity
  enabled        Boolean       @default(true)
  priority       Int
  weight         Int
  createdBy      String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  creator      User?        @relation(fields: [createdBy], references: [id], onDelete: SetNull)
  groups       RuleGroup[]
  conditions   RuleCondition[]
  results      RuleResult[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@index([createdBy])
  @@index([category])
  @@index([severity])
  @@index([enabled])
  @@index([priority])
  @@index([updatedAt])
  @@index([organizationId, enabled, priority])
}

model RuleGroup {
  id             String          @id @default(uuid())
  ruleId         String
  parentGroupId  String?
  operator       LogicalOperator @default(AND)
  position       Int             @default(0)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  rule         Rule            @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  parentGroup  RuleGroup?      @relation("NestedRuleGroups", fields: [parentGroupId], references: [id], onDelete: Cascade)
  childGroups  RuleGroup[]     @relation("NestedRuleGroups")
  conditions   RuleCondition[]

  @@index([ruleId])
  @@index([parentGroupId])
  @@index([ruleId, parentGroupId])
}

model RuleCondition {
  id        String            @id @default(uuid())
  ruleId    String
  groupId   String
  field     String
  operator  ConditionOperator
  value     Json?
  dataType  String
  position  Int               @default(0)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  rule  Rule      @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  group RuleGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([ruleId])
  @@index([groupId])
  @@index([field])
  @@index([ruleId, groupId])
}

model RuleExecution {
  id              String              @id @default(uuid())
  organizationId  String
  transactionId   String?
  source          RuleExecutionSource
  finalScore      Int
  riskLevel       RiskLevel
  executionTimeMs Int
  triggeredCount  Int                 @default(0)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  transaction  Transaction? @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  results      RuleResult[]

  @@index([organizationId])
  @@index([transactionId])
  @@index([source])
  @@index([riskLevel])
  @@index([createdAt])
  @@index([organizationId, createdAt])
}

model RuleResult {
  id          String        @id @default(uuid())
  executionId String
  ruleId      String
  matched     Boolean
  score       Int
  explanation String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  execution RuleExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)
  rule      Rule          @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@index([executionId])
  @@index([ruleId])
  @@index([matched])
  @@index([createdAt])
}

model Decision {
  id                   String        @id @default(uuid())
  organizationId       String
  transactionId        String        @unique
  mlPredictionId       String?       @unique
  userId               String?
  rawScore             Float?
  ruleScore            Int
  mlScore              Int
  finalScore           Int
  category             String?
  decisionOutcome      String?
  confidence           Float
  riskLevel            RiskLevel
  decisionStrategy     String
  decisionVersion      String
  explanation          Json
  recommendation       String
  timeline             Json?
  ensembleBreakdown    Json?
  historicalAdjustment Float?
  metadata             Json?
  processedAt          DateTime
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  mlPrediction MlPrediction? @relation(fields: [mlPredictionId], references: [id], onDelete: SetNull)
  alerts       Alert[]

  @@index([organizationId])
  @@index([transactionId])
  @@index([mlPredictionId])
  @@index([riskLevel])
  @@index([processedAt])
  @@index([organizationId, processedAt])
}

model Alert {
  id                String        @id @default(uuid())
  organizationId    String
  userId            String?
  decisionId        String?
  transactionId     String?
  assignedAnalystId String?
  severity          AlertSeverity
  title             String
  description       String?
  riskScore         Int?          @default(0)
  confidence        Float?        @default(0)
  status            AlertStatus   @default(OPEN)
  isRead            Boolean       @default(false)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user            User?        @relation("AlertUser", fields: [userId], references: [id], onDelete: SetNull)
  assignedAnalyst User?        @relation("AlertAssignedAnalyst", fields: [assignedAnalystId], references: [id], onDelete: SetNull)
  decision        Decision?    @relation(fields: [decisionId], references: [id], onDelete: SetNull)

  comments          AlertComment[]

  @@index([organizationId])
  @@index([userId])
  @@index([assignedAnalystId])
  @@index([decisionId])
  @@index([transactionId])
  @@index([severity])
  @@index([status])
  @@index([isRead])
  @@index([createdAt])
  @@index([organizationId, severity])
  @@index([organizationId, status])
}

model AlertComment {
  id        String   @id @default(uuid())
  alertId   String
  userId    String?
  comment   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  alert Alert @relation(fields: [alertId], references: [id], onDelete: Cascade)
  user  User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([alertId])
  @@index([userId])
  @@index([createdAt])
}

model ActivityLog {
  id             String         @id @default(uuid())
  organizationId String
  userId         String?
  action         String
  entity         ActivityEntity
  entityId       String?
  ipAddress      String?
  metadata       Json?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([userId])
  @@index([action])
  @@index([entity])
  @@index([entityId])
  @@index([createdAt])
  @@index([organizationId, createdAt])
}

enum DriftSeverity {
  NO_DRIFT
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ModelHealthStatus {
  HEALTHY
  WARNING
  DEGRADED
  CRITICAL
}

model MLMonitoringSnapshot {
  id                    String            @id @default(uuid())
  organizationId        String
  modelId               String
  modelVersion          String
  timeWindow            String            @default("24h")
  healthScore           Float             @default(100.0)
  healthStatus          ModelHealthStatus @default(HEALTHY)
  featureDriftScore     Float             @default(0.0)
  predictionDriftScore  Float             @default(0.0)
  dataQualityScore      Float             @default(100.0)
  avgLatencyMs          Float             @default(8.5)
  errorRate             Float             @default(0.0)
  predictionVolume      Int               @default(0)
  anomalyRate           Float             @default(0.0)
  avgConfidence         Float             @default(0.95)
  modelAgreementScore   Float             @default(1.0)
  metricsSummary        Json?
  timestamp             DateTime          @default(now())
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  organization         Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  featureDriftMetrics  FeatureDriftMetric[]
  predictionMetrics    PredictionDriftMetric[]
  dataQualityMetrics   DataQualityMetric[]

  @@index([organizationId])
  @@index([modelId])
  @@index([modelVersion])
  @@index([healthStatus])
  @@index([timestamp])
  @@index([organizationId, timestamp])
  @@index([organizationId, modelId, timestamp])
}

model FeatureDriftMetric {
  id                String        @id @default(uuid())
  snapshotId        String?
  organizationId    String
  modelId           String
  modelVersion      String
  featureName       String
  meanRef           Float?
  meanCurr          Float?
  stdRef            Float?
  stdCurr           Float?
  nullRateRef       Float?        @default(0.0)
  nullRateCurr      Float?        @default(0.0)
  psiScore          Float         @default(0.0)
  ksPValue          Float?        @default(1.0)
  jsDivergence      Float?        @default(0.0)
  severity          DriftSeverity @default(NO_DRIFT)
  distributionRef   Json?
  distributionCurr  Json?
  timestamp         DateTime      @default(now())
  createdAt         DateTime      @default(now())

  snapshot     MLMonitoringSnapshot? @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([snapshotId])
  @@index([organizationId])
  @@index([modelId])
  @@index([featureName])
  @@index([severity])
  @@index([timestamp])
  @@index([organizationId, timestamp])
}

model PredictionDriftMetric {
  id                String        @id @default(uuid())
  snapshotId        String?
  organizationId    String
  modelId           String
  modelVersion      String
  anomalyRateRef    Float         @default(0.05)
  anomalyRateCurr   Float         @default(0.05)
  avgScoreRef       Float         @default(0.20)
  avgScoreCurr      Float         @default(0.20)
  confidenceRef     Float         @default(0.95)
  confidenceCurr    Float         @default(0.95)
  psiScore          Float         @default(0.0)
  severity          DriftSeverity @default(NO_DRIFT)
  scoreDistribution Json?
  timestamp         DateTime      @default(now())
  createdAt         DateTime      @default(now())

  snapshot     MLMonitoringSnapshot? @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([snapshotId])
  @@index([organizationId])
  @@index([modelId])
  @@index([severity])
  @@index([timestamp])
  @@index([organizationId, timestamp])
}

model DataQualityMetric {
  id                        String   @id @default(uuid())
  snapshotId                String?
  organizationId            String
  validCount                Int      @default(0)
  invalidCount              Int      @default(0)
  missingValueRate          Float    @default(0.0)
  duplicateRate             Float    @default(0.0)
  schemaErrorCount          Int      @default(0)
  unexpectedCategoriesCount Int      @default(0)
  qualityScore              Float    @default(100.0)
  issues                    Json?
  timestamp                 DateTime @default(now())
  createdAt                 DateTime @default(now())

  snapshot     MLMonitoringSnapshot? @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([snapshotId])
  @@index([organizationId])
  @@index([timestamp])
  @@index([organizationId, timestamp])
}

model ModelHealthLog {
  id             String            @id @default(uuid())
  organizationId String
  modelId        String
  modelVersion   String
  healthScore    Float
  healthStatus   ModelHealthStatus
  factors        Json?
  reason         String?
  timestamp      DateTime          @default(now())
  createdAt      DateTime          @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([modelId])
  @@index([healthStatus])
  @@index([timestamp])
  @@index([organizationId, timestamp])
}

