# ===========================================
# Auth Service - Environment Variables
# ===========================================
# Copy this file to .env and fill in your values

# Service Configuration
SERVICE_NAME=auth-service
PORT=3002
NODE_ENV=development
LOG_LEVEL=info
JWT_SECRET="your-jwt-secret-key"

# ----- Clerk Configuration (Required) -----
# Get these from your Clerk Dashboard -> API Keys
CLERK_PUBLISHABLE_KEY=pk_test_YOUR_CLERK_PUBLISHABLE_KEY
CLERK_SECRET_KEY=sk_test_YOUR_CLERK_SECRET_KEY
# Webhook Secret (if using webhooks to sync users to DB)
CLERK_WEBHOOK_SECRET=whsec_YOUR_CLERK_WEBHOOK_SECRET

# ----- PostgreSQL Configuration (Shared) -----
# Auth service syncs Clerk users to this DB
DATABASE_URL=postgresql://user:password@host:port/database

# ----- Redis Configuration (Shared) -----
REDIS_URL=redis://localhost:6379/0

# ----- Kafka Configuration (Shared) -----
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CLIENT_ID=auth-service
JWT_SECRET=your-jwt-secret-key

# ----- Google OAuth Configuration -----
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET
API_URL=https://backend.outlierx.me
FRONTEND_URL=https://outlierx.me

# ----------------------------------------
# Email (SMTP)
# ----------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS="YOUR_SMTP_PASSWORD"
EMAIL_FROM=support@outlierx.com
