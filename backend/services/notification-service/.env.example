# ========================================
# Notification Service - Environment Variables // Updted with new anomalyze gmail credentials
# ========================================

# Server Configuration
PORT=
SERVICE_NAME=notification-service
ENABLE_KAFKA= #for testing pusposes.
JWT_SECRET="your-jwt-secret-key"

# ----------------------------------------
# Database (Postgres)
# ----------------------------------------
DATABASE_URL=postgresql://user:password@host:port/database

# ----------------------------------------
# Redis (Deduplication)
# ----------------------------------------
REDIS_URL=

# ----------------------------------------
# Kafka Configuration
# ----------------------------------------
KAFKA_BOOTSTRAP_SERVERS=
KAFKA_CLIENT_ID=notification-service
KAFKA_GROUP_ID=notification-service-group
KAFKA_ANOMALIES_TOPIC=anomalies
KAFKA_ALERTS_TOPIC=alerts

# ----------------------------------------
# Email (SMTP)
# ----------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=YOUR_SMTP_PASSWORD
EMAIL_FROM=support@anomalyze.com


# ----------------------------------------
# Twilio (SMS & Voice)
# ----------------------------------------
TWILIO_ACCOUNT_SID=YOUR_TWILIO_ACCOUNT_SID
TWILIO_AUTH_TOKEN=YOUR_TWILIO_AUTH_TOKEN
TWILIO_PHONE_NUMBER=YOUR_TWILIO_PHONE_NUMBER
TWILIO_CALL_FROM=YOUR_TWILIO_PHONE_NUMBER

# ----------------------------------------
# Webhooks
# ----------------------------------------
WEBHOOK_SIGNING_SECRET=
